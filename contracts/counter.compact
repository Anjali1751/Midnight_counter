// ============================================================
// Private-Owner Counter
//
// PUBLIC (on-chain, visible to anyone):
//   - state: whether the counter has been claimed
//   - owner: a hash commitment of the owner's secret key
//   - count: how many times the owner incremented it
//
// PRIVATE (never leaves the user's device):
//   - the secret key returned by the localSecretKey() witness
//
// PROVED without revealing: the caller knows the secret key
// behind the public owner commitment, so they may increment.
//
// disclose() is used once, deliberately: the owner commitment
// (a hash, not the key itself) must be public so others can
// verify ownership later.
// ============================================================
pragma language_version >= 0.16 && <= 0.23;

import CompactStandardLibrary;

export enum State {
  UNCLAIMED,
  CLAIMED
}

export ledger state: State;
export ledger owner: Bytes<32>;
export ledger count: Counter;

constructor() {
  state = State.UNCLAIMED;
}

witness localSecretKey(): Bytes<32>;

circuit ownerCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "counter:owner:"), sk]);
}

export circuit claim(): [] {
  assert(state == State.UNCLAIMED, "Counter already claimed");
  owner = disclose(ownerCommitment(localSecretKey()));
  state = State.CLAIMED;
}

export circuit increment(): [] {
  assert(state == State.CLAIMED, "Counter has not been claimed yet");
  assert(owner == ownerCommitment(localSecretKey()), "Only the owner can increment");
  count.increment(1);
}
